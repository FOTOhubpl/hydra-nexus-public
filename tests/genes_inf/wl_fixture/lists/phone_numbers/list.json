{
 "name": "synthetic phone_numbers",
 "type": "regex",
 "version": 1,
 "description": "synthetic copy of a few MISP phone_numbers patterns (CC0-1.0) plus one invalid and one overlong entry",
 "matching_attributes": [
  "phone-number",
  "whois-registrant-phone"
 ],
 "list": [
  "/((?:\\+|00)1)?([0-9]{3})55501([0-9]{2})/",
  "/((?:\\+|00)33?|0?)(999)([0-9]{6})/",
  "/((?:\\+|00)44)?07700900([0-9]{3})/",
  "/((?:\\+|00)46)?3139006([0-9]{2})/",
  "/([0-9/",
  ""
 ]
}
